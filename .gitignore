# Rust
target/

# Node / Vite. package-lock.json IS committed: it records exactly which
# JavaScript went into a build, as Cargo.lock does for Rust.
node_modules/
dist/
*.local
.vite/

# Tauri: schemas regenerated on every build. capabilities/ beside them is
# authored and committed (it states the app's permissions).
app/src-tauri/target/
app/src-tauri/gen/schemas/

# Build outputs. Verovio is never committed: it is a separate, replaceable
# library (see THIRD_PARTY.md). `just release` stages a copy in bundle/.
/.verovio-build
/app/src-tauri/bundle
*.AppImage
*.deb

# Environment and secrets
.env
.env.*

# OS and editors
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Scores without a redistribution licence, kept locally for tests
test-scores/

# Local design reference screenshots
/ideal-pics
/picofcurrentapp
